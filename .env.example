# Copier ce fichier en .env puis renseigner une clé API valide localement.
# Les valeurs non vides du .env priment sur l'environnement du terminal.
# Le .env est exclu de Git. Ne pas partager la clé dans une conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Essai explicite de Xiaomi MiMo : --connexion mimo (facultatif).
MIMO_API_KEY=
