  "savoirs_pnj": {
    "marchand": {
      "porte_crypte": {
        "origine": "jeu",
        "revision": 0,
        "texte": "Gorm connaît la porte de chêne au nord de l'antichambre. Une trousse de crochets permet d'en tenter le crochetage, sans garantie de réussite. Ses deux axes de gonds sont amovibles du côté de l'antichambre : un levier adapté peut aider à les extraire un par un. Un couteau risque de casser. Ce savoir décrit la construction, pas son état actuel."
      },
      "prudence": {
        "origine": "jeu",
        "revision": 0,
        "texte": "Gorm préfère laisser l'exploration à quelqu'un d'autre et tenir son échoppe. Il connaît les usages des outils qu'il vend, sans garantir le succès d'une manœuvre."
      }
    }
  },
  "savoirs_version": 1,
  "scenario": {
    "debut": "Tu as accepté de retrouver l'anneau du veilleur à la demande de Gorm. Le marchand t'a conduit de son échoppe à cette antichambre, puis est retourné à ses affaires. C'est là que ton exploration a commencé.",
    "gorm": "Au début de l'exploration, Gorm tenait l'échoppe à l'ouest de l'antichambre. Il t'a demandé de retrouver l'anneau, mais n'a expliqué ni ce qu'il représente pour lui ni pourquoi il ne va pas le chercher lui-même. Au départ, aucune récompense n'avait été convenue.",
    "liberte_personnage": "Le joueur choisit les raisons personnelles de Corvus. Ne lui impose ni sentiments, ni amnésie, ni passé supplémentaire.",
    "objectif": "Retrouver l'anneau du veilleur dans la crypte.",
    "version": 1
  },
